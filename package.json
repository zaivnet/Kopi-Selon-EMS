{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx backend/server.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npx vite build --outDir ../dist/frontend",
    "build:backend": "npx tsc --project backend/tsconfig.json",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./dist/backend/server.js')\"",
    "lint": "eslint .",
    "db:seed": "tsx backend/lib/seed.ts",
    "db:reset": "npx prisma db push --force-reset --schema=database/schema.prisma && tsx backend/lib/seed.ts",
    "predev": "prisma generate --schema=database/schema.prisma",
    "postinstall": "prisma generate --schema=database/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.83.0",
    "react-is": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "9.39.1",
    "firebase-tools": "^15.0.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.1.5"
  }
}
